<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_principal">

    <!-- Contenedor centrado -->
    <LinearLayout
        android:id="@+id/uso_contenedor_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <!-- Logo arriba -->
        <ImageView
            android:id="@+id/uso_logo_login"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_sazon" />

        <!-- Título -->
        <TextView
            android:id="@+id/uso_titulo_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Bienvenido"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/uso_tarjeta_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/fondo_superficie"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/uso_contenido_tarjeta_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Correo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/uso_input_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Correo electrónico">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/uso_campo_correo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/uso_input_contrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Contraseña"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/uso_campo_contrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón iniciar sesión -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uso_boton_iniciar_sesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Entrar"
                    android:textColor="@color/texto_sobre_principal"
                    app:backgroundTint="@color/color_principal_variante"
                    app:cornerRadius="12dp" />

                <!-- Olvidaste -->
                <TextView
                    android:id="@+id/uso_olvidaste_contrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="¿Has olvidado la contraseña?"
                    android:textColor="@color/color_principal"
                    android:textSize="13sp" />

                <!-- Separador -->
                <LinearLayout
                    android:id="@+id/uso_separador_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:alpha="0.35"
                        android:background="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/uso_texto_separador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="o continúa con"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:alpha="0.35"
                        android:background="@color/texto_secundario" />
                </LinearLayout>

                <!-- Botón Google (sin icono) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uso_boton_google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continuar con Google"
                    android:textColor="@color/texto_principal"
                    app:backgroundTint="@color/fondo_superficie"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/color_guardado"
                    app:strokeWidth="1dp" />

                <!-- Registro (link) -->
                <TextView
                    android:id="@+id/uso_texto_registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:text="Crear cuenta"
                    android:textColor="@color/color_principal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>