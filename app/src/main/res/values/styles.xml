<resources>

    <style name="Button.Primary">
        <item name="android:backgroundTint">@android:color/holo_orange_dark</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/abel</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:fontFamily">@font/abel</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:fontFamily">@font/abel</item>
    </style>

    <!-- ✅ ALIAS para compatibilidad con layouts antiguos -->
    <style name="Button" parent="Button.Primary" />
    <style name="Text" parent="Text.Body" />

    <style name="TemaSplash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/color_principal</item>
    </style>

    <!-- Pildora detrás del icono seleccionado del BottomNav -->
    <style name="App.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_principal_variante</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
    </style>
    <style name="ShapeAppearanceSazonRecipeImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

</resources>